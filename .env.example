# ---------------------------------------------------------------------------
# Copy to .env.local for development. Never commit .env.local.
# In production set these as environment variables in the hosting platform.
# ---------------------------------------------------------------------------

# Public origin of the site. Used for canonical links and metadata (build time).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public origin used by the server for payment returns, auth and redirects
# (runtime). Must be https outside localhost.
APP_URL=http://localhost:3000

# Search-engine ownership tokens, optional. Issued by Google Search Console and
# Bing Webmaster Tools after verifying the domain; they are emitted as a meta tag
# only when set. See docs/DEPLOYMENT.md §10.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Database (Postgres 16, start it with `npm run db:up`)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://bpkihs:bpkihs_dev@localhost:5433/bpkihs

# ---------------------------------------------------------------------------
# Auth (Better Auth). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# At least 32 characters; production refuses to start without one.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Registration codes emailed to a new member. Every value has a safe default; set
# one only to differ. See docs/HOWTO.md section 7.
# OTP_LENGTH=6
# OTP_EXPIRES_MINUTES=15
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# AUTH_OTP_MAX=3
# AUTH_OTP_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Email. Development can print messages to the terminal with "console".
# Production must use "resend" plus a verified sending domain.
# ---------------------------------------------------------------------------
EMAIL_TRANSPORT=console
EMAIL_FROM="BPKIHS Alumni Association <no-reply@bpkihs-alumni.local>"
# RESEND_API_KEY=re_...
# Verify the alumni domain in Resend before launch. onboarding@resend.dev only
# delivers to the Resend account owner.

# ---------------------------------------------------------------------------
# Payments. Required: "sandbox" or "live". There is no simulator, and the app
# refuses to start in production without a configured gateway.
# ---------------------------------------------------------------------------
PAYMENT_MODE=sandbox

# eSewa ePay v2: sandbox credentials from https://developer.esewa.com.np
# In live mode ESEWA_GATEWAY_URL is required.
# ESEWA_PRODUCT_CODE=EPAYTEST
# ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# Khalti ePayment v2: sandbox keys from https://docs.khalti.com
# In live mode KHALTI_BASE_URL is required.
# KHALTI_SECRET_KEY=live_secret_key_...
# KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# ConnectIPS (NCHL). Issued by the Association's bank and NCHL technical
# enrollment. The gateway is offered only when all of these are set; onboarding
# is described in HANDOVER.md section 2. NCHL publishes only {base_url}, so take
# the UAT and production hosts from them.
# CONNECTIPS_BASE_URL=https://uat-host-from-nchl.example
# CONNECTIPS_MERCHANT_ID=550
# CONNECTIPS_APP_ID=MER-550-APP-1
# CONNECTIPS_APP_NAME=BPKIHS Alumni
# CONNECTIPS_APP_PASSWORD=...
# NCHL issues CREDITOR.pfx. Node cannot read PKCS#12, so convert it once:
#   openssl pkcs12 -in CREDITOR.pfx -nocerts -nodes -out secrets/connectips.key
#   chmod 600 secrets/connectips.key
# Then point at the PEM file, or paste the PEM with \n escapes:
# CONNECTIPS_PRIVATE_KEY_PATH=./secrets/connectips.key
# CONNECTIPS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Fonepay was agreed on 29 Oct 2026 but has no adapter yet, so nothing here is
# read. Obtain Fonepay's current integration document before implementing it;
# see TRACKER.md C7b and HANDOVER.md section 2.
# FONEPAY_BASE_URL=
# FONEPAY_MERCHANT_CODE=
# FONEPAY_SECRET_KEY=
# FONEPAY_API_USERNAME=
# FONEPAY_API_PASSWORD=

# ---------------------------------------------------------------------------
# Bot protection (Cloudflare Turnstile). Registration, RSVP, contact and the newsletter
# refuse a submission without a valid token once the secret is set, and production
# refuses to start without these. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile and copy the two keys.
# The site key is public and is inlined at build time: set it before `next build`.
# Cloudflare's always-pass test keys are useful locally; never ship the test secret.
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Public office contact details shown on /support. CONTACT_EMAIL is required
# in production; the others are optional and omitted when empty.
# ---------------------------------------------------------------------------
# CONTACT_EMAIL=office@example.org
# CONTACT_PHONE=+977 98XXXXXXXX
# CONTACT_ADDRESS=BPKIHS Alumni Association, Dharan, Koshi Province, Nepal
# CONTACT_HOURS=Sunday to Friday, 10:00 to 17:00 (Nepal time)

# ---------------------------------------------------------------------------
# Operations and security. Every value below has a safe default; set the ones
# that differ for your deployment. See docs/HOWTO.md and docs/SECURITY.md.
# ---------------------------------------------------------------------------

# Name used in email signatures and the auth screen.
# APP_NAME=BPKIHS Alumni Association
# Prefix for helpdesk references, e.g. BPK-2026-A1B2C3.
# SUPPORT_REFERENCE_PREFIX=BPK

# Dates are shown and entered in this time zone (IANA name) and fixed offset.
# Nepal has no daylight saving, so a fixed offset is correct.
# NEXT_PUBLIC_SITE_TIME_ZONE=Asia/Kathmandu
# NEXT_PUBLIC_SITE_UTC_OFFSET=+05:45

# Set true only when a reverse proxy you control overwrites X-Forwarded-For /
# X-Real-IP. Defaults to true in production and false in development.
# TRUST_PROXY=true

# Session policy. Admin actions expire after the idle window.
# SESSION_MAX_AGE_HOURS=24
# SESSION_UPDATE_AGE_MINUTES=15
# ADMIN_REAUTH_AFTER_MINUTES=30

# Largest accepted JSON request body, in bytes (default 128 KiB).
# MAX_REQUEST_BYTES=131072

# Most rows one admin CSV export may return (default 5000).
# EXPORT_MAX_ROWS=5000

# HSTS max-age in seconds (default 180 days).
# HSTS_MAX_AGE_SECONDS=15552000

# Profile photos are written to this directory on the app server. Relative paths
# resolve from the working directory; on a VPS use an absolute directory that
# survives deploys and is writable by the service user. Back it up too.
# PHOTO_UPLOAD_DIR=/var/lib/bpkihs-alumni/photos
# The source image limit is fixed at 5 MB in src/lib/constants/photo.ts.
# PHOTO_MIN_DIMENSION=200
# PHOTO_MAX_DIMENSION=6000
# PHOTO_OUTPUT_SIZE=512
# PHOTO_QUALITY=82

# Newsletter sending: batching and hard recipient cap.
# NEWSLETTER_BATCH_SIZE=50
# NEWSLETTER_MAX_RECIPIENTS=2000

# Comma-separated HTTPS hosts allowed for next/image (default bpkihs.edu).
# IMAGE_HOSTS=bpkihs.edu
