# Database
# For a local PostgreSQL instance, use the same direct URL for both values.
DATABASE_URL=postgresql://bpkihs_app:root@127.0.0.1:5432/bpkihs_alumni?schema=public
DIRECT_DATABASE_URL=postgresql://bpkihs_app:root@127.0.0.1:5432/bpkihs_alumni?schema=public

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email
RESEND_API_KEY=re_replace_with_your_own_key
EMAIL_FROM=BPKIHS Alumni <bpkihs-alumni-local@resend.dev>

# Object Storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payments
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET=
