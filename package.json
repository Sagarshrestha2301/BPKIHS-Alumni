{
  "name": "bpkihs-alumni",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-preflight.mjs && next dev -p 3000",
    "build": "next build",
    "analyze": "next analyze",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "tsx src/server/db/migrate.ts",
    "db:admin": "tsx src/server/db/create-admin.ts",
    "db:seed-alumni": "tsx src/server/db/seed-alumni.ts",
    "db:seed-content": "tsx src/server/db/seed-content.ts",
    "db:fixtures": "tsx e2e/helpers/seed-cli.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "newsletter:digest": "tsx scripts/send-newsletter-digest.ts",
    "connectips:accept": "tsx scripts/connectips-acceptance.ts",
    "db:studio": "drizzle-kit studio",
    "check:env": "tsx src/server/env-check.ts",
    "check:health": "bash scripts/healthcheck.sh",
    "ci": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@base-ui/react": "^1.9.0",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
